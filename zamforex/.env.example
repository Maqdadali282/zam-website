# Gmail account used to send the two automatic contact-form emails
# (admin notification + customer acknowledgement). GMAIL_APP_PASSWORD is
# NOT your regular Gmail password — generate one at:
# https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first)
GMAIL_USER=zamforex110@gmail.com
GMAIL_APP_PASSWORD=

# Inbox that receives the admin notification for every contact form
# submission. Defaults to GMAIL_USER if not set.
CONTACT_ADMIN_EMAIL=zamforex110@gmail.com
